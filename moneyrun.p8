win_wait = 0
win_draw = true
win_circ = 200
win_counter = 0
moneygod = pos.new(33.5, 108.5)

curs = {
	pos = pos.new(8, 64),
	col = 8,
	toggle_num = 0,
	draw = true,
}

wintext = {
	line1 = textline.new(8, 64, "you have finally made it", 7, 0, 46),
	line2 = textline.new(8, 72, "you have become...", 7, 300, 46),
}

function update_win()
	if win_draw then
		win_counter += 1
		
		if win_counter % 15 == 0 then
			curs.toggle_num += 1
		end 
		
		if curs.toggle_num%2 == 0 then
			curs.draw = true
		else
			curs.draw = false
		end
		
		if win_counter % 8 == 0 then
			for key, l in pairs(wintext) do
				if l:can_update(win_counter) then
					l:update()
					curs.pos.x = ?l.str
					curs.pos.y = l.y - 1
				end
			end	
		end
	end -- end win_draw()
end

function draw_win()
	cls()
	map(32, 0, 0, 0, 16, 16)
	spr(32, moneygod.x, moneygod.y, 5, 1)
	spr(44, moneygod.x + 40, moneygod.y, 3, 1)
	
	if win_draw == true then
		circfill(64, 64, win_circ, 9)
		print(win_counter, 8, 8, 7)
		if curs.draw then
			rectfill(curs.pos.x, curs.pos.y, curs.pos.x + 5, curs.pos.y + 6, curs.col)
		end
		
		for key, l in pairs(wintext) do
			print(l.str, l.x, l.y, l.col)
		end
	end
end


